# ============================================================
# PayShield Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real private keys.

# ------------------------------------------------------------
# Network Configuration
# ------------------------------------------------------------
# Local Fhenix node (run via npx fhenix-localfhenix)
LOCAL_FHENIX_RPC_URL=http://127.0.0.1:42069

# Fhenix Helium testnet
FHENIX_TESTNET_RPC_URL=https://api.helium.fhenix.zone

# Arbitrum Sepolia
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Chain IDs
LOCAL_CHAIN_ID=412346
TESTNET_CHAIN_ID=8008135
ARBITRUM_SEPOLIA_CHAIN_ID=421614

# ------------------------------------------------------------
# Deployer / Admin Keys (NEVER use mainnet keys)
# ------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
COMPANY_ADMIN_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
WORKER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
AUDITOR_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# ------------------------------------------------------------
# Contract Addresses (filled after deployment)
# ------------------------------------------------------------
NEXT_PUBLIC_PAYSHIELD_FACTORY_ADDRESS=
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_ACCESS_MANAGER_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ------------------------------------------------------------
# CoFHE / Fhenix SDK
# ------------------------------------------------------------
# These are auto-detected in local mock mode; set for testnet
COFHE_GATEWAY_URL=https://gateway.helium.fhenix.zone

# ------------------------------------------------------------
# Etherscan / Blockscout (for contract verification)
# ------------------------------------------------------------
ETHERSCAN_API_KEY=
FHENIX_EXPLORER_URL=https://explorer.helium.fhenix.zone
